# Server Configuration
PORT=4000

# Azure PostgreSQL Database
# Format: postgres://username:password@server.postgres.database.azure.com:5432/database?sslmode=require
DATABASE_URL=postgres://username:password@server.postgres.database.azure.com:5432/postgres?sslmode=require

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_secret_here

# CORS Origin (use * for development, specific domain for production)
CORS_ORIGIN=*
