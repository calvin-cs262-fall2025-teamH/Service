// Service/src/routes/anniversaryReminders.ts
import { Router } from 'express';
import { query } from '../db';
import { authenticateToken, AuthRequest } from '../middleware/auth';

const router = Router();

/**
 * Helper function to get user's couple_id
 */
async function getUserCoupleId(userId: number): Promise<number | null> {
  const result = await query(
    'SELECT couple_id FROM users WHERE id = $1',
    [userId]
  );
  return result.rows[0]?.couple_id || null;
}

/**
 * POST /api/anniversary-reminders
 * Create a new anniversary reminder
 */
router.post('/', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const { title, description, anniversaryDate, reminderDaysBefore, isRecurring } = req.body;

    if (!title || !anniversaryDate) {
      return res.status(400).json({
        success: false,
        message: 'Title and anniversary date are required'
      });
    }

    const coupleId = await getUserCoupleId(userId);
    if (!coupleId) {
      return res.status(400).json({
        success: false,
        message: 'No couple found. Please connect with your partner first.'
      });
    }

    const result = await query(
      `INSERT INTO anniversary_reminders (couple_id, user_id, title, description, anniversary_date, reminder_days_before, is_recurring, is_enabled, reminder_type, reminder_date, created_at, updated_at) VALUES ($1, $2, $3, $4, $5, $6, $7, true, 'custom', $5, NOW(), NOW())
       RETURNING *`,
      [coupleId, userId, title, description || null, anniversaryDate, reminderDaysBefore || 7, isRecurring !== false]
    );

    const reminder = result.rows[0];

    res.json({
      success: true,
      data: {
        id: reminder.id,
        coupleId: reminder.couple_id,
        title: reminder.title,
        description: reminder.description,
        anniversaryDate: reminder.anniversary_date,
        reminderDaysBefore: reminder.reminder_days_before,
        isRecurring: reminder.is_recurring,
        isEnabled: reminder.is_enabled,
        createdAt: reminder.created_at,
        updatedAt: reminder.updated_at
      },
      message: 'Anniversary reminder created successfully'
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Create error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to create anniversary reminder'
    });
  }
});

/**
 * GET /api/anniversary-reminders
 * Get all anniversary reminders for the user's couple
 */
router.get('/', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const coupleId = await getUserCoupleId(userId);

    if (!coupleId) {
      return res.json({
        success: true,
        data: []
      });
    }

    const result = await query(
      `SELECT * FROM anniversary_reminders
       WHERE couple_id = $1
       ORDER BY anniversary_date ASC`,
      [coupleId]
    );

    const reminders = result.rows.map(row => ({
      id: row.id,
      coupleId: row.couple_id,
      title: row.title,
      description: row.description,
      anniversaryDate: row.anniversary_date,
      reminderDaysBefore: row.reminder_days_before,
      isRecurring: row.is_recurring,
      isEnabled: row.is_enabled,
      createdAt: row.created_at,
      updatedAt: row.updated_at
    }));

    res.json({
      success: true,
      data: reminders
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Get all error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get anniversary reminders'
    });
  }
});

/**
 * GET /api/anniversary-reminders/upcoming
 * Get upcoming anniversary reminders (within next 30 days)
 */
router.get('/upcoming', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const coupleId = await getUserCoupleId(userId);

    if (!coupleId) {
      return res.json({
        success: true,
        data: []
      });
    }

    const result = await query(
      `SELECT * FROM anniversary_reminders
       WHERE couple_id = $1
       AND is_enabled = true
       AND anniversary_date >= CURRENT_DATE
       AND anniversary_date <= CURRENT_DATE + INTERVAL '30 days'
       ORDER BY anniversary_date ASC`,
      [coupleId]
    );

    const reminders = result.rows.map(row => ({
      id: row.id,
      coupleId: row.couple_id,
      title: row.title,
      description: row.description,
      anniversaryDate: row.anniversary_date,
      reminderDaysBefore: row.reminder_days_before,
      isRecurring: row.is_recurring,
      isEnabled: row.is_enabled,
      createdAt: row.created_at,
      updatedAt: row.updated_at
    }));

    res.json({
      success: true,
      data: reminders
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Get upcoming error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get upcoming anniversary reminders'
    });
  }
});

/**
 * GET /api/anniversary-reminders/:id
 * Get a specific anniversary reminder
 */
router.get('/:id', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const { id } = req.params;
    const coupleId = await getUserCoupleId(userId);

    if (!coupleId) {
      return res.status(404).json({
        success: false,
        message: 'No couple found'
      });
    }

    const result = await query(
      'SELECT * FROM anniversary_reminders WHERE id = $1 AND couple_id = $2',
      [id, coupleId]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Anniversary reminder not found'
      });
    }

    const row = result.rows[0];
    res.json({
      success: true,
      data: {
        id: row.id,
        coupleId: row.couple_id,
        title: row.title,
        description: row.description,
        anniversaryDate: row.anniversary_date,
        reminderDaysBefore: row.reminder_days_before,
        isRecurring: row.is_recurring,
        isEnabled: row.is_enabled,
        createdAt: row.created_at,
        updatedAt: row.updated_at
      }
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Get one error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get anniversary reminder'
    });
  }
});

/**
 * PUT /api/anniversary-reminders/:id
 * Update an anniversary reminder
 */
router.put('/:id', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const { id } = req.params;
    const { title, description, anniversaryDate, reminderDaysBefore, isRecurring, isEnabled } = req.body;
    const coupleId = await getUserCoupleId(userId);

    if (!coupleId) {
      return res.status(404).json({
        success: false,
        message: 'No couple found'
      });
    }

    // Check if reminder exists and belongs to user's couple
    const checkResult = await query(
      'SELECT * FROM anniversary_reminders WHERE id = $1 AND couple_id = $2',
      [id, coupleId]
    );

    if (checkResult.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Anniversary reminder not found'
      });
    }

    const updateFields: string[] = [];
    const values: unknown[] = [];
    let paramIndex = 1;

    if (title !== undefined) {
      updateFields.push(`title = $${paramIndex++}`);
      values.push(title);
    }
    if (description !== undefined) {
      updateFields.push(`description = $${paramIndex++}`);
      values.push(description);
    }
    if (anniversaryDate !== undefined) {
      updateFields.push(`anniversary_date = $${paramIndex++}`);
      values.push(anniversaryDate);
    }
    if (reminderDaysBefore !== undefined) {
      updateFields.push(`reminder_days_before = $${paramIndex++}`);
      values.push(reminderDaysBefore);
    }
    if (isRecurring !== undefined) {
      updateFields.push(`is_recurring = $${paramIndex++}`);
      values.push(isRecurring);
    }
    if (isEnabled !== undefined) {
      updateFields.push(`is_enabled = $${paramIndex++}`);
      values.push(isEnabled);
    }

    if (updateFields.length === 0) {
      return res.status(400).json({
        success: false,
        message: 'No fields to update'
      });
    }

    updateFields.push(`updated_at = NOW()`);
    values.push(id, coupleId);

    const result = await query(
      `UPDATE anniversary_reminders
       SET ${updateFields.join(', ')}
       WHERE id = $${paramIndex++} AND couple_id = $${paramIndex++}
       RETURNING *`,
      values
    );

    const reminder = result.rows[0];

    res.json({
      success: true,
      data: {
        id: reminder.id,
        coupleId: reminder.couple_id,
        title: reminder.title,
        description: reminder.description,
        anniversaryDate: reminder.anniversary_date,
        reminderDaysBefore: reminder.reminder_days_before,
        isRecurring: reminder.is_recurring,
        isEnabled: reminder.is_enabled,
        createdAt: reminder.created_at,
        updatedAt: reminder.updated_at
      },
      message: 'Anniversary reminder updated successfully'
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Update error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to update anniversary reminder'
    });
  }
});

/**
 * PUT /api/anniversary-reminders/:id/toggle
 * Toggle the enabled status of an anniversary reminder
 */
router.put('/:id/toggle', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const { id } = req.params;
    const coupleId = await getUserCoupleId(userId);

    if (!coupleId) {
      return res.status(404).json({
        success: false,
        message: 'No couple found'
      });
    }

    const result = await query(
      `UPDATE anniversary_reminders
       SET is_enabled = NOT is_enabled, updated_at = NOW()
       WHERE id = $1 AND couple_id = $2
       RETURNING *`,
      [id, coupleId]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Anniversary reminder not found'
      });
    }

    const reminder = result.rows[0];

    res.json({
      success: true,
      data: {
        id: reminder.id,
        coupleId: reminder.couple_id,
        title: reminder.title,
        description: reminder.description,
        anniversaryDate: reminder.anniversary_date,
        reminderDaysBefore: reminder.reminder_days_before,
        isRecurring: reminder.is_recurring,
        isEnabled: reminder.is_enabled,
        createdAt: reminder.created_at,
        updatedAt: reminder.updated_at
      },
      message: 'Anniversary reminder toggled successfully'
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Toggle error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to toggle anniversary reminder'
    });
  }
});

/**
 * DELETE /api/anniversary-reminders/:id
 * Delete an anniversary reminder
 */
router.delete('/:id', authenticateToken, async (req: AuthRequest, res) => {
  try {
    const userId = req.userId!;
    const { id } = req.params;
    const coupleId = await getUserCoupleId(userId);

    if (!coupleId) {
      return res.status(404).json({
        success: false,
        message: 'No couple found'
      });
    }

    const result = await query(
      'DELETE FROM anniversary_reminders WHERE id = $1 AND couple_id = $2 RETURNING *',
      [id, coupleId]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Anniversary reminder not found'
      });
    }

    res.json({
      success: true,
      message: 'Anniversary reminder deleted successfully'
    });
  } catch (error: unknown) {
    console.error('[anniversaryReminders] Delete error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to delete anniversary reminder'
    });
  }
});

export default router;
